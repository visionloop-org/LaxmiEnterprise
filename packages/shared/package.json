{
  "name": "@laxmi/shared",
  "version": "1.0.0",
  "description": "Shared code for Laxmi Enterprise attendance systems",
  "main": "index.js",
  "module": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "type": "module",
  "scripts": {
    "build": "echo 'No build step needed for JS modules'",
    "dev": "echo 'No dev script needed'",
    "generate:types": "openapi-typescript ../../ServerSide/openapi.json -o types/api.ts",
    "check:types": "node check-types.js",
    "check-types": "node check-types.js",
    "sync:types": "cd ../../ServerSide && python scripts/export_openapi.py && cd ../packages/shared && npm run generate:types",
    "test": "mocha --exit --require @babel/register --require mocha.config.cjs tests/hooks/*.test.js tests/utils/*.test.js tests/components/*.test.jsx tests/services/googleSheetsService.test.js",
    "test:hooks": "mocha --exit --require @babel/register --require mocha.config.cjs tests/hooks/*.test.js",
    "test:utils": "mocha --exit --require @babel/register --require mocha.config.cjs tests/utils/*.test.js",
    "test:components": "mocha --exit --require @babel/register --require mocha.config.cjs tests/components/*.test.jsx",
    "test:gsheets": "mocha --exit --require @babel/register --require mocha.config.cjs tests/services/googleSheetsService.test.js",
    "test:all": "mocha --exit --require @babel/register --require mocha.config.cjs tests/hooks/*.test.js tests/utils/*.test.js tests/components/*.test.jsx tests/services/googleSheetsService.test.js",
    "test:services": "mocha --exit --require @babel/register --require mocha.config.cjs tests/services/googleSheetsService.test.js"
  },
  "keywords": [
    "shared",
    "attendance",
    "laxmi"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "chai": "^6.2.2",
    "jsdom": "^29.1.1",
    "mocha": "^11.8.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
