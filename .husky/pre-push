#!/usr/bin/env sh
# Husky pre-push hook for Laxmi Enterprise
# Enforces full compilation & test suites before any git push

echo "🚀 Running pre-push compilation & build checks..."

# 1. Compile supervisor app
echo "📦 Testing Supervisor build..."
npm run build --workspace=apps/supervisor || {
  echo "❌ Supervisor compilation failed! Aborting push."
  exit 1
}

# 2. Compile admin app
echo "📦 Testing Admin build..."
npm run build --workspace=apps/admin || {
  echo "❌ Admin compilation failed! Aborting push."
  exit 1
}

# 3. Test unified bundle assembly
echo "📦 Testing GitHub Pages unified distribution build..."
node scripts/build-gh-pages.js || {
  echo "❌ GitHub Pages assembly failed! Aborting push."
  exit 1
}

# 4. Run test suites (utils + google sheets service)
echo "🧪 Running utility tests..."
npm run test:utils --workspace=packages/shared || {
  echo "❌ Utility tests failed! Aborting push."
  exit 1
}

echo "🧪 Running Google Sheets service tests..."
npm run test:gsheets --workspace=packages/shared || {
  echo "❌ Google Sheets service tests failed! Aborting push."
  exit 1
}

echo "🧪 Running Client Computation Engine tests..."
npm run test:computation --workspace=packages/shared || {
  echo "❌ Client computation tests failed! Aborting push."
  exit 1
}

echo "🧪 Running Drive CSV & 5-Year Retention tests..."
npm run test:drivecsv --workspace=packages/shared || {
  echo "❌ Drive CSV service tests failed! Aborting push."
  exit 1
}

echo "✅ All compilation, assembly, and test checks passed! Proceeding with git push."
